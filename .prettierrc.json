{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 120,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "none",
  "overrides": [
    {
      "files": "**/*.md",
      "excludeFiles": ["AGENTS.md", "README.md"],
      "options": { "proseWrap": "never", "printWidth": 10000, "embeddedLanguageFormatting": "off" }
    }
  ]
}
