{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turn-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  // Next to Jev, which answers from us-west-2.
  "placement": { "region": "aws:us-west-2" },
  // One object per app user, reached by the salted hash of their ID, which counts their requests and free lines and
  // calls Jev for their lines, and one for the relay, which counts the day's calls to Jev (SEC-3, SEC-5).
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE", "class_name": "Device" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "exports": {
    "Device": { "type": "durable-object", "storage": "sqlite" },
    "Budget": { "type": "durable-object", "storage": "sqlite" }
  },
  // 120 requests a minute from each address, a backstop for IDs minted on one; each ID's object counts its 30 (SEC-3).
  "ratelimits": [{ "name": "ADDRESS_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }],
  // Only the relay's own log line: invocation logs hold each request's details, and traces the IDs in URLs.
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": false } },
  // A deploy fails while any of these is unset (SEC-1).
  "secrets": { "required": ["TYPESAFE_API_KEY", "RC_SECRET_KEY", "ID_SALT"] },
  "vars": {
    "JEV_MODEL": "jev-1.13.0",
    // Each switch is on only as "true": Jev (STATE-3), naming TypeSafe (CONSENT-7), and letting requests from the
    // Simulator build skip the count until judging ends (PAY-9).
    "JEV_ON": "true",
    "TYPESAFE_NAMED": "false",
    "SIMULATOR_UNLIMITED": "false",
    "FREE_LINES": "20",
    // The calls to Jev all users share in a UTC day, retries included, past which lines get `jev_unavailable` (SEC-5).
    "JEV_DAILY_CALLS": "10000",
    // RevenueCat's project and the object ID of its `listen` entitlement, for the check past the free lines (PAY-7).
    "RC_PROJECT_ID": "proj9f033172",
    "RC_ENTITLEMENT_ID": "entl6b65cc982a",
    // Only the values that differ from the starting policy in @turn/shared/row (ROW-8).
    "POLICY": {}
  }
}
