{
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/mobile",
    "apps/relay",
    "packages/shared",
    "packages/eval"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "eval": "bun packages/eval/src/report.ts",
    "eval:count": "bun packages/eval/src/count.ts",
    "graph": "graphify update .",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepare": "husky",
    "replay": "bun packages/eval/src/replay.ts",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
